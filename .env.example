# Inert development template. No wallet, database or financial authority.
# The synthetic submission-demo launcher configures its own guarded TEST session;
# copying this file is neither necessary nor sufficient to launch that demo.
APP_ENV=development
ZCASH_NETWORK=testnet
LOG_LEVEL=warn

# Intentionally unset: DATABASE_URL, PGHOST, PGPORT, PGDATABASE, PGUSER,
# PGPASSWORD, PGPASSFILE, DARKPOOL_PG_ENV, DARKPOOL_PG_PROFILE,
# DARKPOOL_WATCHER_INTERNAL, WALLET_DB_PATH and all signing credentials.
# Configure separately approved services privately through their existing
# purpose-bound launchers. Never put real credentials or keys in this template.
# Never select DEV, OLD LIVE or HISTORICAL for the synthetic submission demo.
